<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKLumiHex.Mac.MainWindow"
        Title="PKLumiHex for macOS"
        Width="1040" Height="720"
        MinWidth="860" MinHeight="600">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Name="OpenButton" Content="Open Save..." Click="OnOpenClick" />
      <Button Name="SaveButton" Content="Save (with .bak)" Click="OnSaveClick" IsEnabled="False" />
      <Button Name="SaveAsButton" Content="Save As..." Click="OnSaveAsClick" IsEnabled="False" />
      <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Text="Open a Luminescent Platinum SaveData.bin to begin." />
    </StackPanel>

    <TabControl Name="MainTabs" IsEnabled="False">
      <TabItem Header="Party &amp; Boxes">
        <Grid ColumnDefinitions="320,*" Margin="8">
          <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <TextBlock Text="Container:" VerticalAlignment="Center" />
              <ComboBox Name="ContainerPicker" Width="210" SelectionChanged="OnContainerChanged" />
            </StackPanel>
            <ListBox Name="SlotList" SelectionChanged="OnSlotSelected" />
          </DockPanel>

          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10" Margin="4">
              <TextBlock Name="SlotHeader" FontSize="16" FontWeight="SemiBold" Text="Select a slot to edit" />

              <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nickname" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="NicknameBox" Margin="0,0,12,8" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Species ID" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="3" Name="SpeciesBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Form" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="FormBox" Margin="0,0,12,8" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Level" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="3" Name="LevelBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Held Item ID" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Name="HeldItemBox" Margin="0,0,12,8" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Item Name" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBlock Grid.Row="2" Grid.Column="3" Name="HeldItemNameText" VerticalAlignment="Center" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Shiny" VerticalAlignment="Center" Margin="0,0,8,8" />
                <CheckBox Grid.Row="3" Grid.Column="1" Name="ShinyCheck" Content="Is Shiny" Margin="0,0,12,8" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Ability ID" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="3" Grid.Column="3" Name="AbilityBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Quick Stones" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                  <Button Content="Give Charizardite X (660)" Click="OnGiveCharizarditeX" />
                  <Button Content="Give Charizardite Y (678)" Click="OnGiveCharizarditeY" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Moves (IDs)" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="*,*,*,*">
                <TextBox Grid.Column="0" Name="Move1Box" Watermark="Move 1" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Name="Move2Box" Watermark="Move 2" Margin="0,0,8,0" />
                <TextBox Grid.Column="2" Name="Move3Box" Watermark="Move 3" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" Name="Move4Box" Watermark="Move 4" />
              </Grid>

              <TextBlock Text="IVs (HP / Atk / Def / SpA / SpD / Spe)" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="*,*,*,*,*,*">
                <TextBox Grid.Column="0" Name="IvHpBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Name="IvAtkBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="2" Name="IvDefBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="3" Name="IvSpaBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="4" Name="IvSpdBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="5" Name="IvSpeBox" />
              </Grid>

              <TextBlock Text="EVs (HP / Atk / Def / SpA / SpD / Spe)" FontWeight="SemiBold" Margin="0,6,0,0" />
              <Grid ColumnDefinitions="*,*,*,*,*,*">
                <TextBox Grid.Column="0" Name="EvHpBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Name="EvAtkBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="2" Name="EvDefBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="3" Name="EvSpaBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="4" Name="EvSpdBox" Margin="0,0,6,0" />
                <TextBox Grid.Column="5" Name="EvSpeBox" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Apply Changes to Slot" Click="OnApplyPokemonClick" />
                <TextBlock Name="PokemonStatusText" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Bag Editor">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Pocket:" VerticalAlignment="Center" />
            <ComboBox Name="PocketPicker" Width="220" SelectionChanged="OnPocketChanged" />
            <Button Content="Grant Mega Kit (Key Stone + Charizardite X &amp; Y)" Click="OnGrantMegaKitClick" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Item ID:" VerticalAlignment="Center" />
            <TextBox Name="BagItemIdBox" Width="90" Watermark="e.g. 660" />
            <TextBlock Text="Count:" VerticalAlignment="Center" />
            <TextBox Name="BagItemCountBox" Width="80" Text="1" />
            <Button Content="Add / Update in Pocket" Click="OnAddBagItemClick" />
            <TextBlock Name="BagStatusText" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>

          <ListBox Name="BagItemList" SelectionChanged="OnBagItemSelected" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Trainer Info">
        <StackPanel Margin="12" Spacing="10" MaxWidth="460" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trainer Name" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="TrainerNameBox" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Money" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="1" Grid.Column="1" Name="MoneyBox" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Language ID" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="LanguageBox" Margin="0,0,0,8" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Save Version" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Name="VersionText" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Apply Trainer Info" Click="OnApplyTrainerClick" />
            <TextBlock Name="TrainerStatusText" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
